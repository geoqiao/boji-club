---
import SiteLayout from '../layouts/SiteLayout.astro';
import { posts } from '../lib/content';
import { sections } from '../lib/navigation';
const ordered = sections.flatMap(section => section.slugs.map(slug => posts.find(post => post.slug === slug)).filter(Boolean));
const startPath = ordered[0]?.path ?? '#learning-path';
const chapterIcons = [
  '<path d="M8 25V12h8v13M20 25V7h8v18M4 25h28M12 5v3M9 5h6" />',
  '<path d="M5 15h6v10H5zM25 15h6v10h-6zM11 20h14M3 18v4M33 18v4M9 8h18" />',
  '<path d="M7 8h22v21H7zM7 14h22M12 5v6M24 5v6M12 19h3M21 19h3M12 24h3" />',
  '<path d="M18 5c-4 6-11 11-11 17a11 11 0 0 0 22 0c0-6-7-11-11-17ZM12 23c0 3 2 5 5 5" />'
];
---
<SiteLayout>
  <main id="main-content" class="home-main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy"><p class="eyebrow"><span class="tiny-square"></span> A LITTLE STRONGER, EVERY DAY</p>
      <h1 id="hero-title">不必练成谁。<br />练成<span class="highlight-word">更好的自己<svg viewBox="0 0 370 18" preserveAspectRatio="none" aria-hidden="true"><path d="M3 12C85 3 216 3 365 10M24 16C110 8 247 8 342 12" /></svg></span>。</h1>
      <p class="hero-description">从第一组动作，到一套能坚持的日常。<br />一起了解训练、饮食与恢复，让身体有力，让生活轻盈。</p>
      <div class="hero-actions"><a class="button button-primary" href={startPath}>从这里开始 <span aria-hidden="true">↗</span></a><a class="text-link" href="#learning-path">先看看学习地图 <span aria-hidden="true">↓</span></a></div>
      <div class="hero-footnote"><span class="status-dot"></span>不追求速成。给身体一点时间。</div></div>
      <div class="hero-art" aria-hidden="true">
        <div class="art-grid"></div><span class="art-coordinate">FIG. 01 — FIND YOUR PACE</span>
        <svg class="figure-art" viewBox="0 0 340 355" fill="none">
          <path d="M56 292h233M77 302h192" stroke="#173d32" stroke-width="1.5"/>
          <path d="m195 80-34 40-26 51-49 18 13 18 60-18 36-51" fill="#dce3cf" stroke="#173d32" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="m192 82 31 17 19 54 43 25-10 18-55-28-26-44" fill="#dce3cf" stroke="#173d32" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="m166 120 30-28 19 47-11 63-56 7 1-49 17-40Z" fill="#173d32" stroke="#173d32" stroke-width="2.5"/>
          <path d="m150 199 54-3 6 41 38 45-22 9-45-43-9-25-28 38-39 27-14-15 32-30 27-44Z" fill="#cddd62" stroke="#173d32" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="m91 273 15 14-8 8H69c-2-7 11-13 22-22ZM228 281l19-4 18 14-3 6h-31l-3-16Z" fill="#173d32"/>
          <circle cx="207" cy="63" r="22" fill="#f2ddc4" stroke="#173d32" stroke-width="2.5"/>
          <path d="M186 62c-7-27 38-38 45-6-8-5-17-7-25-4l-6 12-14-2Z" fill="#173d32"/>
          <path d="m206 85-9 13 15 13 10-22" fill="#f2ddc4" stroke="#173d32" stroke-width="2.5"/>
          <path d="m83 183 17 27M78 190l28 11M72 192l6-11M104 208l6-11M268 176l18 25M264 183l28 10M260 186l5-11M289 199l6-11" stroke="#173d32" stroke-width="6" stroke-linecap="round"/>
          <path d="m71 81 8 14 15 4-15 6-6 15-5-15-14-5 14-5 3-14Z" fill="#d2e36b"/><path d="M266 93h27M280 80v27" stroke="#173d32" stroke-width="1.5"/>
          <path d="m44 235 5-8M294 236l7 7" stroke="#173d32" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <div class="art-sticker">适量训练<br /><strong>长期主义。</strong><span>EST. EVERY DAY</span></div>
        <span class="art-caption">身体的进步，发生在日常里。</span>
      </div>
    </section>
    <section class="learning-section" id="learning-path" aria-labelledby="learning-title">
      <div class="section-heading"><div><p class="eyebrow">YOUR FIELD GUIDE</p><h2 id="learning-title">从理解身体，到开始行动。</h2></div><span class="section-aside">按自己的节奏，一章一章来 ↙</span></div>
      <div class="chapter-grid">{sections.map((section, i) => {
        const chapterPosts = section.slugs.map(slug => posts.find(post => post.slug === slug)).filter(Boolean);
        return <article class="chapter-card"><div class="chapter-card-top"><span class="chapter-number">CHAPTER {String(i + 1).padStart(2, '0')}</span><svg viewBox="0 0 36 36" fill="none" aria-hidden="true" set:html={chapterIcons[i % chapterIcons.length]} /></div><h3>{section.title}</h3><p>{section.description}</p><ul>{chapterPosts.slice(0, 3).map(post => post && <li><a href={post.path}>{post.title}<span aria-hidden="true">↗</span></a></li>)}</ul><a class="chapter-explore" href={chapterPosts[0]?.path ?? '#learning-path'}>开始这一章<span aria-hidden="true">→</span></a></article>;
      })}</div>
    </section>
    <section class="principles" aria-labelledby="principles-title"><div class="principles-label"><span class="tiny-square"></span><h2 id="principles-title">我们的训练原则</h2><span>LESS, BUT CONSISTENT.</span></div><div><span class="principle-index">01</span><h3>健康优先</h3><p>先照顾身体，再讨论表现。</p></div><div><span class="principle-index">02</span><h3>循序渐进</h3><p>从适合自己的强度开始。</p></div><div><span class="principle-index">03</span><h3>把坚持变轻</h3><p>能持续的计划，才是好计划。</p></div></section>
    <div class="home-endnote"><span aria-hidden="true">✳</span><p>这里没有完美身材的标准答案。<br /><strong>只有一起把日子过得更健康的普通人。</strong></p><a href="https://github.com/geoqiao/boji-club/issues" target="_blank" rel="noopener noreferrer">带着问题，一起讨论 ↗</a></div>
  </main>
</SiteLayout>
