---
import SiteLayout from '../layouts/SiteLayout.astro';
import { posts, type Post } from '../lib/content';
import { sections } from '../lib/navigation';
const findPost = (slug: string) => posts.find(post => post.slug === slug);
const starters = [
  { slug: 'boji-spirit', title: '先找到值得坚持的理由', description: '了解薄肌俱乐部，也看看开场视频。' },
  { slug: 'first-workout', title: '完成你的第一次训练', description: '从热身到收尾，跟着练一次。' },
  { slug: 'weights-and-sets', title: '学会选重量、安排组数', description: '找到适合自己的起点，慢慢进步。' },
].map(item => ({ ...item, post: findPost(item.slug) })).filter(item => item.post);
const movements = (sections.find(section => section.id === 'movements')?.slugs ?? [])
  .map(findPost).filter((post): post is Post => !!post);
const plan = findPost('weekly-plan');
const questions = (sections.find(section => section.id === 'questions')?.slugs ?? [])
  .map(findPost).filter((post): post is Post => !!post);
const firstWorkout = findPost('first-workout');
---
<SiteLayout>
  <main id="main-content" class="home-main">
    <section class="hero" aria-labelledby="hero-title">
      <p class="hero-intro">写给普通人的健身入门指南</p>
      <h1 id="hero-title">为健康而练。<br /><span>把训练，放进日常。</span></h1>
      <p class="hero-description">从第一次走进健身房，到找到能坚持的节奏。<br class="desktop-break" />一起把动作、重量和训练安排，一点点弄明白。</p>
      <div class="hero-actions">
        <a class="button button-primary" href={firstWorkout?.path ?? '#start'}>开始第一练 <span aria-hidden="true">→</span></a>
        <a class="button button-outline" href="#guides">浏览动作指南</a>
      </div>
    </section>
    <section class="start-panel" id="start" aria-labelledby="start-title">
      <div class="start-copy"><p class="section-label">从这里开始</p><h2 id="start-title">不用全懂，<br />也可以开始。</h2><p>先了解为什么练，再完成一次简单训练。<br />不赶进度，找到自己的起点就好。</p></div>
      <ol class="start-steps">{starters.map((item, i) => item.post && <li><a href={item.post.path}><span class="step-number" aria-hidden="true">{i + 1}</span><div><h3>{item.title}</h3><p>{item.description}</p></div><span class="link-arrow" aria-hidden="true">↗</span></a></li>)}</ol>
    </section>
    <section class="guide-section" id="guides" aria-labelledby="guides-title">
      <div class="section-heading"><h2 id="guides-title">把基础动作练明白。</h2><p>胸、背、肩、腿与有氧，从少数动作开始。</p></div>
      <div class="guide-list">{movements.map(post => <a class="guide-link" href={post.path}><div><h3>{post.title}</h3><p>{post.description}</p></div><span class="link-arrow" aria-hidden="true">↗</span></a>)}</div>
    </section>
    <div class="more-guides">
      <section aria-labelledby="plan-title"><div class="section-heading"><h2 id="plan-title">让训练成为日常。</h2><p>适合自己的安排，才更容易坚持。</p></div>{plan && <a class="guide-link" href={plan.path}><div><h3>{plan.title}</h3><p>{plan.description}</p></div><span class="link-arrow" aria-hidden="true">↗</span></a>}</section>
      <section id="questions" aria-labelledby="questions-title"><div class="section-heading"><h2 id="questions-title">你可能也在想。</h2><p>走进健身房之前和之后的小问题。</p></div>{questions.map(post => <a class="guide-link compact" href={post.path}><h3>{post.title}</h3><span class="link-arrow" aria-hidden="true">↗</span></a>)}</section>
    </div>
  </main>
</SiteLayout>
