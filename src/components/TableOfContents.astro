---
interface Props { toc: { id: string; text: string; level: number }[] }
const { toc } = Astro.props;
---
<aside class="page-toc" aria-label="本页目录">
  <div class="toc-sticky"><h2>本页目录</h2>
  <nav><ul>{toc.map(item => <li class:list={{ 'toc-nested': item.level > 2 }}><a href={`#${item.id}`}>{item.text}</a></li>)}<li><a href="#discussion">讨论</a></li></ul></nav>
  </div>
</aside>
