---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Brand from '../components/Brand.astro';
import Search from '../components/Search.astro';
import { site } from '../lib/site';
interface Props { title?: string; description?: string; article?: boolean; noindex?: boolean }
const { title, description = site.description, article = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : `${site.title} · 把训练，放进日常`;
const canonical = new URL(Astro.url.pathname, site.url).href;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title><meta name="description" content={description} />{!noindex && <link rel="canonical" href={canonical} />}
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content={article ? 'article' : 'website'} /><meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:site_name" content={site.title} /><meta property="og:locale" content="zh_CN" />
  <meta name="twitter:card" content="summary" /><meta name="theme-color" content="#ffffff" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script is:inline src="/site.js" defer></script><script is:inline src="/search.js" defer></script>
</head>
<body class:list={{ 'article-page': article }}>
  <a class="skip-link" href="#main-content">跳到正文</a>
  <header class="site-header">
    <div class="header-inner">
      <Brand />
      <nav class="header-nav" aria-label="主要导航">
        <a href="/#start">从这里开始</a>
        <a href="/#guides">动作指南</a>
        <a href="/#questions">常见问题</a>
      </nav>
      <button class="search-trigger" data-open-search aria-label="搜索知识库"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><span>搜索</span><kbd>⌘ K</kbd></button>
    </div>
  </header>
  <div class:list={['site-body', { 'with-sidebar': article }]}>
    {article && <Sidebar />}
    <div class="page-content">
      <slot />
      <footer class="site-footer"><div><a href="/">薄肌俱乐部</a><p>为健康而练，按自己的节奏。</p></div><a href={`https://github.com/${site.repo}`} target="_blank" rel="noopener noreferrer">在 GitHub 一起完善 <span aria-hidden="true">↗</span></a></footer>
    </div>
  </div>
  <Search />
</body>
</html>
